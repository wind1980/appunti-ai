<Window x:Class="MeNoter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeNoter" Width="1240" Height="840" MinWidth="980" MinHeight="660"
        Icon="/Assets/MeNoter.ico"
        Background="{StaticResource Background}" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Ink}"
        Closing="Window_Closing">
    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <DockPanel Margin="0,0,0,14">
            <Image Source="/Assets/logo.png" Width="38" Height="38" DockPanel.Dock="Left" Margin="0,0,12,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="⚙  Impostazioni"
                    Click="Settings_Click" Margin="8,0,0,0"/>
            <Button x:Name="SyncButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="SyncNow_Click"
                    Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Sincronizza adesso">
                <TextBlock x:Name="SyncText" Text="☁"/>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MeNoter" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Registra le chiamate, trascrivi sul PC, chiedi a Claude" Style="{StaticResource Hint}"/>
            </StackPanel>
        </DockPanel>

        <!-- Registrazione della chiamata: scheda colorata come quella dell'app Android -->
        <Border Grid.Row="1" CornerRadius="24" Padding="20" Margin="0,0,0,14" Background="{StaticResource HeroGradient}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#4255FF"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="🎙  Microfono (la tua voce)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="MicBox" SelectionChanged="Device_Changed"/>
                    <ProgressBar x:Name="MicLevel" Style="{StaticResource Level}" Margin="0,10,0,0"
                                 Foreground="#7CF0B8" Background="#33FFFFFF"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="🎧  Audio della chiamata (casse, cuffie, auricolari)" Foreground="White"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="OutBox" SelectionChanged="Device_Changed"/>
                    <ProgressBar x:Name="OutLevel" Style="{StaticResource Level}" Margin="0,10,0,0"
                                 Foreground="White" Background="#33FFFFFF"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="TestButton" Style="{StaticResource OnHero}" Content="Prova audio" Click="Test_Click"/>
                    <Button Style="{StaticResource OnHero}" Content="↻" ToolTip="Aggiorna i dispositivi"
                            Click="RefreshDevices_Click" Margin="0,0,0,8"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="True">
                    <Button x:Name="RecordButton" DockPanel.Dock="Left" Style="{StaticResource Record}"
                            Content="●  Registra" Click="Record_Click" Margin="0,0,8,0"/>
                    <Button x:Name="PauseButton" DockPanel.Dock="Left" Style="{StaticResource OnHero}"
                            Content="❚❚  Pausa" Click="Pause_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="StopButton" DockPanel.Dock="Left" Style="{StaticResource OnHero}"
                            Content="■  Fine" Click="Stop_Click" IsEnabled="False" Margin="0,0,18,0"/>
                    <TextBlock x:Name="TimerText" DockPanel.Dock="Left" Text="00:00" FontSize="26" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0" MinWidth="80"/>
                    <TextBox x:Name="NewTitleBox" Style="{StaticResource Field}" Tag="Titolo della riunione (facoltativo)"
                             Background="#26FFFFFF" BorderBrush="#40FFFFFF" Foreground="White" CaretBrush="White"/>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Elenco note -->
            <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="📂" ToolTip="Apri la cartella delle note"
                                Click="OpenRoot_Click" Margin="0"/>
                        <TextBlock Text="Le tue note" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource Field}" Margin="0,0,0,10"
                             Tag="🔍  Cerca nei titoli e nelle trascrizioni" TextChanged="Search_Changed"/>
                    <Button DockPanel.Dock="Bottom" Content="＋  Importa audio o video…" Click="Import_Click"
                            Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                    <ListBox x:Name="NotesList" SelectionChanged="Notes_SelectionChanged" BorderThickness="0"
                             Background="Transparent" ItemContainerStyle="{StaticResource NoteItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Apri cartella" Click="OpenFolder_Click"/>
                                <MenuItem Header="Sposta nel cestino di MeNoter" Click="Delete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="13"
                                            Background="{StaticResource BrandSoft}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Meta.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Nota aperta -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <StackPanel x:Name="EmptyText" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                        <Image Source="/Assets/logo.png" Width="72" Height="72" Margin="0,0,0,16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Pronto a registrare" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center"
                                   Text="Scegli il microfono e l'uscita audio della chiamata (con auricolari o cuffie Bluetooth scegli quelli), premi Registra all'inizio della riunione e Fine alla fine. MeNoter trascrive sul PC e poi chiedi a Claude riassunti, azioni e mappe."/>
                    </StackPanel>

                    <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBox x:Name="TitleBox" FontSize="22" FontWeight="Bold" BorderThickness="0,0,0,1"
                                     BorderBrush="{StaticResource Line}" Background="Transparent" Padding="0,2"
                                     LostFocus="Title_LostFocus" KeyDown="Title_KeyDown"/>
                            <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                            <WrapPanel>
                                <Button x:Name="TranscribeButton" Content="✎  Trascrivi" Click="Transcribe_Click"/>
                                <Button Content="▶  Ascolta" Click="Play_Click"/>
                                <Button Content="📂  Cartella" Click="OpenFolder_Click"/>
                            </WrapPanel>
                            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                <ProgressBar x:Name="TaskProgress" Style="{StaticResource Level}"
                                             Foreground="{StaticResource Brand}" Background="{StaticResource SurfaceHigh}"/>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="18" Padding="14" Margin="0,4,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,10">
                                        <Run Text="✦" Foreground="{StaticResource Violet}"/>
                                        <Run Text=" Chiedi a Claude (con il tuo account Pro)"/>
                                    </TextBlock>
                                    <WrapPanel x:Name="ClaudeButtons"/>
                                    <DockPanel Margin="0,2,0,10">
                                        <Button DockPanel.Dock="Right" Content="Chiedi" Style="{StaticResource Primary}"
                                                Click="Ask_Click" Margin="8,0,0,0"/>
                                        <TextBox x:Name="AskBox" Style="{StaticResource Field}"
                                                 Tag="Fai una domanda sulla riunione…"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="📋  Incolla risposta (testo o immagine)"
                                                Style="{StaticResource Primary}" Click="Paste_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="RevealButton" DockPanel.Dock="Left" Content="Mostra il file"
                                                Click="Reveal_Click" Margin="0,0,12,0" Visibility="Collapsed"
                                                ToolTip="Il testo completo inviato a Claude, da trascinare nella chat se serve"/>
                                        <TextBlock x:Name="ClaudeHint" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="Ogni comando apre Claude con la trascrizione allegata e il comando già scritto: tu premi Invio. Poi copia la risposta di Claude (testo o immagine) e premi «Incolla risposta»."/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TabControl x:Name="ContentTabs"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
