<Window x:Class="MeNoter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni – MeNoter" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6FB" FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="20">
        <TextBlock Text="Cartella delle note" Style="{StaticResource Label}"/>
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Sfoglia…" Click="Browse_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Padding="6"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                   Text="In una cartella di OneDrive le note (audio, trascrizione, risposte) arrivano anche sugli altri dispositivi."/>

        <TextBlock Text="Modello di trascrizione" Style="{StaticResource Label}"/>
        <ComboBox x:Name="ModelBox" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                   Text="Si scarica una volta sola. Più è grande, più è preciso ma lento. Tutto resta sul PC."/>

        <TextBlock Text="Lingua delle riunioni" Style="{StaticResource Label}"/>
        <ComboBox x:Name="LanguageBox" Margin="0,0,0,16"/>

        <CheckBox x:Name="AutoBox" Content="Trascrivi subito quando finisce la registrazione" Margin="0,0,0,8"/>
        <CheckBox x:Name="DesktopBox" Content="Apri l'app Claude per desktop (se no, claude.ai nel browser)" Margin="0,0,0,8"/>
        <CheckBox x:Name="PasteBox" Content="Incolla da sola la richiesta in Claude (poi premi tu Invio)" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Click="Cancel_Click"/>
            <Button Content="Salva" Style="{StaticResource Primary}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
